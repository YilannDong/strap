{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strap config",
  "type": "object",
  "properties": {
    "include": { "type": "array", "items": { "type": "string" } },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "string", "description": "Directory holding tokens.json, registry.json, code-connect.json" },
    "rules": {
      "type": "object",
      "description": "Severity per rule: 'error' (blocks the write), 'warn', or 'off'.",
      "properties": {
        "rawHex": { "enum": ["error", "warn", "off"] },
        "rawRgb": { "enum": ["error", "warn", "off"] },
        "rawFont": { "enum": ["error", "warn", "off"] },
        "offScaleSpacing": { "enum": ["error", "warn", "off"] },
        "offScaleRadius": { "enum": ["error", "warn", "off"] },
        "unlinkedComponent": { "enum": ["error", "warn", "off"] },
        "duplicateComponent": { "enum": ["error", "warn", "off"] },
        "figmaDuplicateComponent": { "enum": ["error", "warn", "off"] },
        "figmaDuplicateFrame": { "enum": ["error", "warn", "off"] }
      }
    },
    "allow": {
      "type": "object",
      "properties": {
        "colors": { "type": "array", "items": { "type": "string" } },
        "spacingPx": { "type": "array", "items": { "type": "number" } }
      }
    },
    "evaluate": {
      "type": "object",
      "description": "Thresholds for `strap evaluate` (component-lifecycle radar).",
      "properties": {
        "promoteMin": { "type": "number", "description": "Min occurrences of a recurring pattern before proposing it as a component (default 3)." },
        "retireMax": { "type": "number", "description": "Max total usages for a component to be a retirement candidate (default 1)." },
        "minFootprint": { "type": "number", "description": "Min tokens a pattern must use to be considered (default 3)." },
        "staleMonths": { "type": "number", "description": "Flag a component as a retirement candidate if last used more than this many months ago, per git history (default 6)." }
      }
    }
  }
}
